# ExpenseTrack - Environment Configuration Example
# Copy this file to .env and adjust credentials as appropriate for your environment.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-at-least-32-chars-cryptographically-random-secret
FLASK_HOST=127.0.0.1
PORT=5000

# Security & Session Settings
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME=86400
TRUST_PROXY_HEADERS=false
ALLOWED_ORIGINS=
# Never enable demo seeding in production
ALLOW_DEMO_SEED=false

# Database Backend Selection
# Local development: mariadb | Integration testing: mariadb or mssql | Azure production: mssql
DB_BACKEND=mariadb
# Authentication mode: password | trusted (Windows/LocalDB) | managed_identity (Azure Entra ID)
DB_AUTH_MODE=password
# Optional explicit SQLAlchemy URL override (takes precedence over discrete host/port/user/name vars)
DATABASE_URL=
# SQL Server ODBC driver & connection options (used when DB_BACKEND=mssql)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# MariaDB / SQL Server Discrete Connection Settings (use environment secrets in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=expensetrack

# Storage & Upload Configuration
UPLOAD_FOLDER=uploads/receipts
MAX_CONTENT_LENGTH=5242880 # 5 MB max file size

# OCR Engine (Leave empty if Tesseract is in system PATH, or specify full binary path)
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Azure Cloud Integration (DP-900 / Azure Cloud Storage)
# Optional: Provide Azure Storage connection string for private cloud receipt backup
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=receipts

